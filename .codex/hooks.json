{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/check-doc-sync.py\" --codex-hook",
            "timeout": 10,
            "statusMessage": "Recording documentation sync baseline"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/check-doc-sync.py\" --codex-hook",
            "timeout": 15,
            "statusMessage": "Checking documentation sync"
          }
        ]
      }
    ]
  }
}
