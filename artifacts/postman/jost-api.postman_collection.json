{
  "info": {
    "_postman_id": "1a8c42d9-890e-4a72-9b1f-0a5700000001",
    "name": "jost api",
    "description": "Focused SynqLien Management API collection for balance verification, reductions, lien entry, and record email/note/status updates. The default baseUrl calls Liens.Api directly on port 5009. To call through the gateway, set baseUrl to http://localhost:5010/liens. Supply a JWT with SYNQ_LIENS product access and the permissions required by each request. No credentials are stored in this collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1 - Balance Verification",
      "description": "There is no single balance-verification endpoint. Reproduce the tenant portal balance by reading case liens, payments, and the latest persisted reduction per lien. Formula: totalBilling - latestReduction - sum(payments).",
      "item": [
        {
          "name": "List Liens for Case",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/liens/liens?caseId={{caseId}}&page=1&pageSize=100",
            "description": "Returns lien rows and aggregated totalBilling. The servicing UI uses totalBilling as the starting amount. Requires SYNQ_LIENS.lien:read."
          }
        },
        {
          "name": "Get Lien Detail",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/liens/liens/{{lienId}}",
            "description": "Returns originalAmount and persisted currentBalance. The servicing UI computes its displayed balance independently. Requires SYNQ_LIENS.lien:read."
          }
        },
        {
          "name": "Get Payments by Case",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/liens/settlement/payments/case/{{caseId}}",
            "description": "Sum payment amount values by lienId. Requires SYNQ_LIENS.lien:read."
          }
        },
        {
          "name": "Get Latest Reductions by Case",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/liens/settlement/reductions/case/{{caseId}}",
            "description": "Returns the most recently persisted reduction for each lien in the case. Requires SYNQ_LIENS.lien:read."
          }
        }
      ]
    },
    {
      "name": "2 - Reductions",
      "item": [
        {
          "name": "Create Reduction",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body.id) pm.collectionVariables.set('reductionId', body.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"caseId\": \"{{caseId}}\",\n  \"lienId\": \"{{lienId}}\",\n  \"reductionDate\": \"{{businessDate}}\",\n  \"amount\": 2500.00,\n  \"note\": \"Negotiated reduction\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/liens/settlement/reductions",
            "description": "Creates a canonical reduction and saves its ID into reductionId. Requires SYNQ_LIENS.lien:update."
          }
        },
        {
          "name": "Update Reduction",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reductionDate\": \"{{businessDate}}\",\n  \"amount\": 2250.00,\n  \"note\": \"Corrected reduction amount\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/liens/settlement/reductions/{{reductionId}}",
            "description": "Updates a tenant-scoped reduction. Requires SYNQ_LIENS.lien:update."
          }
        },
        {
          "name": "Get Reductions by Lien",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/liens/settlement/reductions/lien/{{lienId}}",
            "description": "Returns reduction history for one lien. Requires SYNQ_LIENS.lien:read."
          }
        },
        {
          "name": "Legacy Create Single Reduction",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"caseId\": \"{{caseId}}\",\n  \"lienId\": \"{{lienId}}\",\n  \"reductionDate\": \"{{businessDate}}\",\n  \"amount\": 2500.00,\n  \"note\": \"Legacy single reduction\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/service/liens/update/reduction",
            "description": "Legacy single-item compatibility contract. Requires SYNQ_LIENS.lien:update."
          }
        },
        {
          "name": "Legacy Create Bulk Reductions",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"caseId\": \"{{caseId}}\",\n  \"note\": \"Batch reduction\",\n  \"data\": [\n    {\n      \"liensId\": \"{{lienId}}\",\n      \"reductionAmount\": 1000.00,\n      \"reductionDate\": \"{{businessDate}}\",\n      \"note\": \"Optional row note\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/service/liens/update/reduction",
            "description": "Legacy bulk reduction contract used by the tenant portal. Requires SYNQ_LIENS.lien:update."
          }
        },
        {
          "name": "Get Settlement History",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/service/settlement/history/{{caseId}}",
            "description": "Returns settlements, reductions, and payments for the case. Requires SYNQ_LIENS.lien:read."
          }
        },
        {
          "name": "Get Settlement History V3",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"caseId\": \"{{caseId}}\",\n  \"page\": 1,\n  \"limit\": 20\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/service/settlement/history/v3",
            "description": "Paged payment, reduction, settlement, and law-firm-change history. Requires SYNQ_LIENS.lien:read."
          }
        }
      ]
    },
