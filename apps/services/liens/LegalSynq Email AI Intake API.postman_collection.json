                }
              ],
              "cookie": [],
              "body": "{\n  \"items\": [\n    {\n      \"id\": \"0198b9f7-13d9-7cc4-a6f2-904ff8fd2db4\",\n      \"lienNumber\": \"26-000123-01\",\n      \"caseId\": \"0198b9f4-f7e5-7c01-9f40-c2bb32ebfd89\",\n      \"lienType\": \"MedicalLien\",\n      \"originalAmount\": 12500.00,\n      \"sourceType\": \"Email\",\n      \"status\": \"Pending\",\n      \"intakeStatus\": \"Pending\",\n      \"operationalStatus\": \"Draft\",\n      \"operationalStatusLabel\": \"Open\",\n      \"openedAtUtc\": null,\n      \"createdAtUtc\": \"2026-08-14T01:35:00Z\"\n    }\n  ],\n  \"page\": 1,\n  \"pageSize\": 20,\n  \"totalCount\": 1,\n  \"totalPages\": 1\n}"
