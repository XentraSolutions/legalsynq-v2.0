{
  "info": {
    "_postman_id": "633441a1-e94a-4ef0-84ee-c2fb7457836c",
    "name": "LegalSynq Email AI Intake API",
    "description": "Contract collection for the planned SynqLien Email-AI intake APIs. Email creation uses a Xenia service token and always creates SourceType=Email, IntakeStatus=Pending records. Review and approval use a human reviewer token. The organization is resolved from the trusted org_id service-token claim and is not accepted in the URL or request body. These requests become executable when the corresponding backend endpoints are implemented.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Email AI Creation",
      "item": [
        {
          "name": "Create Pending Case from Email AI",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Created or replayed successfully\", function () {",
                  "  pm.expect([200, 201]).to.include(pm.response.code);",
                  "});",
                  "if ([200, 201].includes(pm.response.code)) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set(\"caseId\", body.id);",
                  "  pm.test(\"Email intake is pending\", function () {",
                  "    pm.expect(body.sourceType).to.eql(\"Email\");",
                  "    pm.expect(body.intakeStatus).to.eql(\"Pending\");",
                  "    pm.expect(body.status).to.eql(\"Pending\");",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{serviceToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{caseIdempotencyKey}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"caseNumber\": \"\",\n  \"clientFirstName\": \"Jordan\",\n  \"clientLastName\": \"Reyes\",\n  \"externalReference\": \"email-{{sourceMessageId}}\",\n  \"title\": \"Email AI intake - motor vehicle accident\",\n  \"clientDob\": \"1990-05-14\",\n  \"clientPhone\": \"+15555550100\",\n  \"clientEmail\": \"jordan.reyes@example.test\",\n  \"clientAddress\": \"100 Main Street, Los Angeles, CA 90001\",\n  \"dateOfIncident\": \"2026-08-10\",\n  \"insuranceCarrier\": \"Example Insurance\",\n  \"policyNumber\": \"POL-10001\",\n  \"claimNumber\": \"CLM-10001\",\n  \"description\": \"Case details extracted from an inbound email.\",\n  \"notes\": \"Review all extracted values before approval.\",\n  \"sex\": \"Unspecified\",\n  \"caseType\": \"Motor Vehicle Accident\",\n  \"currentMedicalStatus\": \"Treating\",\n  \"stateOfIncident\": \"CA\",\n  \"trackingFollowUpDate\": \"2026-08-21\",\n  \"leadId\": null,\n  \"shareCase\": \"No\",\n  \"minorComp\": \"No\",\n  \"caseDropped\": \"No\",\n  \"childSupportLiens\": \"No\",\n  \"isUccFiled\": \"No\",\n  \"lawFirmId\": null,\n  \"accidentTypeId\": null,\n  \"caseManagerId\": null,\n  \"statusLabel\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/liens/internal/email-ai/cases",
            "description": "Creates a tenant- and organization-scoped pending case from Xenia Email AI. The service token must contain tenant_id, org_id, actor_user_id, role=service, and svc=xenia-service. Source, intake status, operational status, tenant, organization, and audit actor are server-controlled. Reuse the same Idempotency-Key only when retrying the exact same payload."
          },
          "response": [
            {
              "name": "Created - Pending Email Case",
              "status": "Created",
              "code": 201,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "cookie": [],
              "body": "{\n  \"id\": \"0198b9f4-f7e5-7c01-9f40-c2bb32ebfd89\",\n  \"caseNumber\": \"26-00123\",\n  \"clientFirstName\": \"Jordan\",\n  \"clientLastName\": \"Reyes\",\n  \"clientDisplayName\": \"Jordan Reyes\",\n  \"sourceType\": \"Email\",\n  \"status\": \"Pending\",\n  \"intakeStatus\": \"Pending\",\n  \"operationalStatus\": \"PreDemand\",\n  \"operationalStatusLabel\": \"New\",\n  \"openedAtUtc\": null,\n  \"createdAtUtc\": \"2026-08-14T01:30:00Z\"\n}"
            },
            {
              "name": "Conflict - Idempotency Key Payload Changed",
              "status": "Conflict",
              "code": 409,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/problem+json"
                }
              ],
              "cookie": [],
              "body": "{\n  \"title\": \"Idempotency conflict\",\n  \"status\": 409,\n  \"detail\": \"The Idempotency-Key was already used with a different request payload.\",\n  \"code\": \"EMAIL_INTAKE_IDEMPOTENCY_CONFLICT\"\n}"
            }
          ]
        },
        {
          "name": "Create Pending Lien from Email AI",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Created or replayed successfully\", function () {",
                  "  pm.expect([200, 201]).to.include(pm.response.code);",
                  "});",
                  "if ([200, 201].includes(pm.response.code)) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set(\"lienId\", body.id);",
                  "  pm.test(\"Email intake is pending\", function () {",
                  "    pm.expect(body.sourceType).to.eql(\"Email\");",
                  "    pm.expect(body.intakeStatus).to.eql(\"Pending\");",
                  "    pm.expect(body.status).to.eql(\"Pending\");",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{serviceToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{lienIdempotencyKey}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lienNumber\": \"\",\n  \"externalReference\": \"email-{{sourceMessageId}}\",\n  \"lienType\": \"MedicalLien\",\n  \"caseId\": \"{{caseId}}\",\n  \"facilityId\": null,\n  \"originalAmount\": 12500.00,\n  \"jurisdiction\": \"CA\",\n  \"isConfidential\": false,\n  \"subjectFirstName\": \"Jordan\",\n  \"subjectLastName\": \"Reyes\",\n  \"incidentDate\": \"2026-08-10\",\n  \"purchaseDate\": null,\n  \"initialServiceDate\": \"2026-08-11\",\n  \"endServiceDate\": null,\n  \"isBulk\": \"No\",\n  \"isServicing\": \"Yes\",\n  \"description\": \"Medical lien details extracted from an inbound email.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/liens/internal/email-ai/liens",
            "description": "Creates a pending lien from Xenia Email AI. caseId may reference an authorized pending Email-AI case through the intake-specific repository path. Tenant and organization are resolved from the signed service token."
          },
          "response": [
            {
              "name": "Created - Pending Email Lien",
              "status": "Created",
              "code": 201,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "cookie": [],
              "body": "{\n  \"id\": \"0198b9f7-13d9-7cc4-a6f2-904ff8fd2db4\",\n  \"lienNumber\": \"26-000123-01\",\n  \"lienType\": \"MedicalLien\",\n  \"caseId\": \"0198b9f4-f7e5-7c01-9f40-c2bb32ebfd89\",\n  \"originalAmount\": 12500.00,\n  \"sourceType\": \"Email\",\n  \"status\": \"Pending\",\n  \"intakeStatus\": \"Pending\",\n  \"operationalStatus\": \"Draft\",\n  \"operationalStatusLabel\": \"Open\",\n  \"openedAtUtc\": null,\n  \"createdAtUtc\": \"2026-08-14T01:35:00Z\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Pending Review",
      "item": [
        {
          "name": "List Pending Email Cases",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{reviewerToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/liens/cases/email-review/pending?page={{page}}&pageSize={{pageSize}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "liens",
                "cases",
                "email-review",
                "pending"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "{{page}}"
                },
                {
                  "key": "pageSize",
                  "value": "{{pageSize}}"
                }
              ]
            },
            "description": "Returns only SourceType=Email and IntakeStatus=Pending cases for the reviewer's tenant. Requires case:read permission."
          },
          "response": [
            {
              "name": "OK - Pending Cases",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "cookie": [],
              "body": "{\n  \"items\": [\n    {\n      \"id\": \"0198b9f4-f7e5-7c01-9f40-c2bb32ebfd89\",\n      \"caseNumber\": \"26-00123\",\n      \"clientFirstName\": \"Jordan\",\n      \"clientLastName\": \"Reyes\",\n      \"sourceType\": \"Email\",\n      \"status\": \"Pending\",\n      \"intakeStatus\": \"Pending\",\n      \"operationalStatus\": \"PreDemand\",\n      \"operationalStatusLabel\": \"New\",\n      \"openedAtUtc\": null,\n      \"createdAtUtc\": \"2026-08-14T01:30:00Z\"\n    }\n  ],\n  \"page\": 1,\n  \"pageSize\": 20,\n  \"totalCount\": 1,\n  \"totalPages\": 1\n}"
            }
          ]
        },
