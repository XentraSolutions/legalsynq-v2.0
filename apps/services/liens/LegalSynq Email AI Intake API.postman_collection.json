    },
    {
      "name": "Approval",
      "item": [
        {
          "name": "Approve Pending Email Case",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{reviewerToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/liens/cases/{{caseId}}/email-review/approve",
            "description": "Atomically approves one Email-AI case. Requires case:update. The server changes IntakeStatus from Pending to Approved, sets OpenedAtUtc, and exposes the case as New while persisting canonical PreDemand. No request body or target status is accepted."
          },
          "response": [
            {
              "name": "OK - Case Approved as New",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "cookie": [],
              "body": "{\n  \"id\": \"0198b9f4-f7e5-7c01-9f40-c2bb32ebfd89\",\n  \"caseNumber\": \"26-00123\",\n  \"sourceType\": \"Email\",\n  \"status\": \"New\",\n  \"statusLabel\": \"New\",\n  \"intakeStatus\": \"Approved\",\n  \"operationalStatus\": \"PreDemand\",\n  \"openedAtUtc\": \"2026-08-14T02:00:00Z\",\n  \"reviewedAtUtc\": \"2026-08-14T02:00:00Z\",\n  \"reviewedByUserId\": \"00000000-0000-0000-0000-000000000002\"\n}"
            },
            {
              "name": "Conflict - Already Reviewed",
              "status": "Conflict",
              "code": 409,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/problem+json"
                }
              ],
              "cookie": [],
              "body": "{\n  \"title\": \"Email intake already reviewed\",\n  \"status\": 409,\n  \"detail\": \"The case is no longer pending review.\",\n  \"code\": \"EMAIL_INTAKE_ALREADY_REVIEWED\"\n}"
            }
          ]
        },
        {
          "name": "Approve Pending Email Lien",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{reviewerToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/liens/liens/{{lienId}}/email-review/approve",
            "description": "Atomically approves one Email-AI lien. Requires lien:update. The server changes IntakeStatus from Pending to Approved, sets OpenedAtUtc, and exposes the persisted Draft lien as Open. No request body or target status is accepted."
          },
          "response": [
            {
              "name": "OK - Lien Approved as Open",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
