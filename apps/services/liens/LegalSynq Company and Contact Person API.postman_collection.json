      "value": "20000000-0000-0000-0000-000000000001"
    },
    {
      "key": "contactPersonTypeFilter",
      "value": ""
    },
    {
      "key": "companyId",
      "value": "00000000-0000-0000-0000-000000000000"
    },
    {
      "key": "companyContactId",
      "value": "00000000-0000-0000-0000-000000000000"
    },
    {
