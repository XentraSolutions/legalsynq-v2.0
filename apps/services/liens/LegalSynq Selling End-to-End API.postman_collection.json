{
  "info": {
    "name": "LegalSynq Selling End-to-End API",
    "description": "End-to-end Postman collection for the SynqLien selling workflow in legalsynq-v2.0. Includes prerequisite case and lien creation, core selling portfolio lifecycle endpoints, and related read APIs like bill-of-sales. Use this when you want a regression-friendly flow instead of the narrower selling-only collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Set {{token}} before running authenticated requests.",
          "// Update {{baseUrl}} to your gateway or direct liens API URL.",
          "// buyerOrgId must come from an existing buyer organization that is valid for selling."
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5009"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "caseId",
      "value": "00000000-0000-0000-0000-000000000000"
    },
    {
      "key": "newCaseId",
      "value": "00000000-0000-0000-0000-000000000000"
    },
    {
      "key": "caseNumber",
      "value": "CASE-POSTMAN-001"
    },
    {
      "key": "lienId",
      "value": "00000000-0000-0000-0000-000000000000"
    },
    {
      "key": "secondLienId",
      "value": "00000000-0000-0000-0000-000000000000"
    },
    {
      "key": "lienCode",
      "value": "LIEN-POSTMAN-001"
    },
    {
      "key": "secondLienCode",
      "value": "LIEN-POSTMAN-002"
    },
    {
      "key": "portfolioId",
      "value": "00000000-0000-0000-0000-000000000000"
    },
    {
      "key": "portfolioNumber",
      "value": "PORT-POSTMAN-001"
    },
    {
      "key": "buyerOrgId",
      "value": "00000000-0000-0000-0000-000000000000"
    },
    {
      "key": "buyerContactId",
      "value": "00000000-0000-0000-0000-000000000000"
    },
    {
      "key": "buyerDetailsUrl",
      "value": "https://app.legalsynq.local/selling/portfolio/{{portfolioId}}/liens/{{lienCode}}"
    },
    {
      "key": "billOfSaleId",
      "value": "00000000-0000-0000-0000-000000000000"
    },
    {
      "key": "billOfSaleNumber",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Prerequisites - Cases",
      "description": "Create and inspect a case before creating selling-eligible liens.",
      "item": [
        {
          "name": "Create Case",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body.id) {",
                  "    pm.collectionVariables.set('caseId', body.id);",
                  "    pm.collectionVariables.set('newCaseId', body.id);",
                  "  }",
                  "  if (body.caseNumber) pm.collectionVariables.set('caseNumber', body.caseNumber);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"caseNumber\": \"{{caseNumber}}\",\n  \"clientFirstName\": \"Postman\",\n  \"clientLastName\": \"Seller\",\n  \"externalReference\": \"CASE-E2E-001\",\n  \"title\": \"Selling Regression Case\",\n  \"clientDob\": \"1990-01-15\",\n  \"clientPhone\": \"+1-555-0100\",\n  \"clientEmail\": \"postman.case@example.com\",\n  \"clientAddress\": \"100 Regression Ave\",\n  \"dateOfIncident\": \"2026-01-05\",\n  \"insuranceCarrier\": \"Sample Carrier\",\n  \"policyNumber\": \"POL-001\",\n  \"claimNumber\": \"CLM-001\",\n  \"description\": \"Created by the LegalSynq Selling End-to-End Postman collection\",\n  \"notes\": \"Setup case for selling workflow validation\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/liens/cases",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "liens",
                "cases"
              ]
            },
            "description": "POST /api/liens/cases. Captures the response id into {{caseId}} and {{newCaseId}}."
          }
        },
        {
          "name": "Search Cases",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/liens/cases?search={{caseNumber}}&page=1&pageSize=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "liens",
                "cases"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "{{caseNumber}}"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "20"
                }
              ]
            },
            "description": "GET /api/liens/cases."
          }
        },
        {
          "name": "Get Case By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/liens/cases/{{caseId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "liens",
                "cases",
                "{{caseId}}"
              ]
            },
            "description": "GET /api/liens/cases/{id}."
          }
        }
      ]
    },
