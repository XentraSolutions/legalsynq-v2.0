            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200', () => pm.response.to.have.status(200));",
                  "pm.test('returns payment summary and items', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('summary');",
                  "  pm.expect(body).to.have.property('items').that.is.an('array');",
