        {
          "name": "Record Case Payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{createPaymentIdempotencyKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 1000.00,\n  \"paymentDate\": \"{{paymentDate}}\",\n  \"paymentMethod\": \"Check\",\n  \"referenceNumber\": \"CHK-POSTMAN-001\",\n  \"detailsContext\": \"Selling payment created from Postman\",\n  \"notes\": \"Postman payment\",\n  \"settlementType\": \"by_funding_company\",\n  \"settlementStatus\": \"partial_payment\",\n  \"lienStatus\": null,\n  \"allocations\": [\n    {\n      \"lienId\": \"{{lienId}}\",\n      \"amount\": 1000.00\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/liens/cases/{{caseId}}/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "liens",
                "cases",
                "{{caseId}}",
                "payments"
              ]
            },
            "description": "Records one atomic payment receipt. Allocation amounts must equal amount and cannot exceed each lien's outstanding selling balance. Requires SYNQ_LIENS.lien:settle and a fresh Idempotency-Key."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('returns the recorded allocations', () => {",
                  "  pm.expect(body).to.have.property('receiptId');",
                  "  pm.expect(body).to.have.property('allocations').that.is.an('array').and.not.empty;",
                  "});",
                  "if (body.allocations && body.allocations.length > 0 && body.allocations[0].id) {",
                  "  pm.collectionVariables.set('paymentId', body.allocations[0].id);",
                  "}"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "201 - Payment recorded",
