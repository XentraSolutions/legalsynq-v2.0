            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ReadyForReview\",\n  \"notes\": \"Ready for operations review from Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/liens/selling/portfolios/{{portfolioId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "liens",
                "selling",
                "portfolios",
                "{{portfolioId}}",
                "status"
              ]
            },
            "description": "POST /api/liens/selling/portfolios/{id}/status. Valid statuses are enforced by the domain transition rules."
          }
        },
        {
          "name": "Transition To Published",
          "request": {
            "method": "POST",
