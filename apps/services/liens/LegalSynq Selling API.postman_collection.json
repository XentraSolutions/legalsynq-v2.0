                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/liens/selling/portfolios/{{portfolioId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "liens",
                "selling",
                "portfolios",
                "{{portfolioId}}",
                "status"
              ]
            },
            "description": "POST /api/liens/selling/portfolios/{id}/status."
          }
        },
        {
          "name": "Transition To Closed",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Closed\",\n  \"notes\": \"Closed from Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/liens/selling/portfolios/{{portfolioId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "liens",
                "selling",
                "portfolios",
                "{{portfolioId}}",
                "status"
              ]
            },
            "description": "POST /api/liens/selling/portfolios/{id}/status."
          }
        }
      ]
    },
