{
  "info": {
    "name": "LegalSynq Selling V2 API",
    "description": "Planned lien-first SynqLien selling API collection based on analysis/SynqLiens/synqlien-selling-backend-api-rebuild-plan.md. Use {{token}} for seller requests and {{buyerToken}} for authenticated buyer requests. Public-token requests intentionally use no auth.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Set {{token}} to a seller JWT and {{buyerToken}} to a buyer JWT before running authenticated requests.",
          "// Clear {{idempotencyKey}} when you want a fresh key; keep it unchanged when testing retries.",
          "if (!pm.collectionVariables.get('idempotencyKey')) {",
          "  pm.collectionVariables.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5009"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "buyerToken",
      "value": ""
    },
    {
      "key": "idempotencyKey",
      "value": ""
    },
    {
      "key": "sellerLienId",
      "value": "00000000-0000-0000-0000-000000000000"
    },
    {
      "key": "lienNumber",
      "value": "LN-POSTMAN-001"
    },
    {
      "key": "caseId",
      "value": "00000000-0000-0000-0000-000000000000"
    },
    {
      "key": "fundingCompanyId",
      "value": "00000000-0000-0000-0000-000000000000"
    },
    {
      "key": "fundingCompanyContactId",
      "value": "00000000-0000-0000-0000-000000000000"
    },
    {
      "key": "buyerFundingCompanyId",
      "value": "00000000-0000-0000-0000-000000000000"
    },
    {
      "key": "buyerContactId",
      "value": "00000000-0000-0000-0000-000000000000"
    },
    {
      "key": "handlingLawFirmId",
      "value": "00000000-0000-0000-0000-000000000000"
    },
    {
      "key": "caseManagerId",
      "value": "00000000-0000-0000-0000-000000000000"
    },
    {
      "key": "facilityId",
      "value": "00000000-0000-0000-0000-000000000000"
    },
    {
      "key": "documentId",
      "value": "00000000-0000-0000-0000-000000000000"
    },
    {
      "key": "bulkImportId",
      "value": "00000000-0000-0000-0000-000000000000"
    },
    {
      "key": "buyerAccessToken",
      "value": ""
    },
    {
      "key": "contactId",
      "value": "00000000-0000-0000-0000-000000000000"
    },
    {
      "key": "targetContactId",
      "value": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "item": [
    {
      "name": "01 - Dashboard and List",
      "item": [
        {
          "name": "Get Dashboard",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/liens/selling/dashboard?tab=pending&search=&fundingCompanyId=&lawFirmId=&caseManagerId=&facilityId=&initialServiceDateFrom=&initialServiceDateTo=&sortBy=initialServiceDate&sortDirection=desc&page=1&pageSize=25",
            "description": "GET /api/liens/selling/dashboard. Returns summary cards, tab totals, and paginated portfolio rows."
          }
        },
        {
          "name": "List Selling Liens",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/liens/selling/liens?tab=pending&search=&fundingCompanyId=&lawFirmId=&caseManagerId=&facilityId=&sortBy=initialServiceDate&sortDirection=desc&page=1&pageSize=25",
            "description": "GET /api/liens/selling/liens. Returns seller lien rows without dashboard summary cards."
          }
        }
      ]
    },
    {
      "name": "02 - Single Lien Wizard",
      "item": [
        {
          "name": "Create Draft Lien",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const body = pm.response.json();",
                  "  const id = body.lienId || body.id;",
                  "  if (id) pm.collectionVariables.set('sellerLienId', id);",
                  "  if (body.lienNumber) pm.collectionVariables.set('lienNumber', body.lienNumber);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sellerStatus\": \"Draft\",\n  \"source\": \"Single\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/liens/selling/liens/drafts",
            "description": "POST /api/liens/selling/liens/drafts. Captures {{sellerLienId}} from lienId or id."
          }
        },
        {
          "name": "Save Step 1 - Lien Information",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sellerStatus\": \"Pending\",\n  \"initialServiceDate\": \"2026-07-19\",\n  \"endServiceDate\": null,\n  \"listingVisibility\": \"Private\",\n  \"notes\": \"Created from Postman selling v2 collection\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/liens/selling/liens/{{sellerLienId}}/lien-information",
            "description": "PUT /api/liens/selling/liens/{lienId}/lien-information."
          }
        },
        {
          "name": "Save Step 2 - Case Information",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fundingCompanyId\": \"{{fundingCompanyId}}\",\n  \"fundingCompanyContactId\": \"{{fundingCompanyContactId}}\",\n  \"handlingLawFirmId\": \"{{handlingLawFirmId}}\",\n  \"caseManagerId\": \"{{caseManagerId}}\",\n  \"caseId\": \"{{caseId}}\",\n  \"createCaseIfMissing\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/liens/selling/liens/{{sellerLienId}}/case-information",
            "description": "PUT /api/liens/selling/liens/{lienId}/case-information."
          }
        },
        {
          "name": "Save Step 3 - Medical Pricing",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"askAmount\": 12500,\n  \"billingAmount\": 18000,\n  \"rows\": [\n    {\n      \"medicalCode\": \"99213\",\n      \"description\": \"Office visit\",\n      \"serviceDate\": \"2026-07-19\",\n      \"billingAmount\": 600,\n      \"medicareCost\": 180,\n      \"targetSaleAmount\": 350\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/liens/selling/liens/{{sellerLienId}}/medical-pricing",
            "description": "PUT /api/liens/selling/liens/{lienId}/medical-pricing. Top-level billingAmount maps to Lien.OriginalAmount."
          }
        },
        {
          "name": "Save Step 4 - Documents",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"documents\": [\n    {\n      \"documentId\": \"{{documentId}}\",\n      \"documentType\": \"MedicalBill\",\n      \"displayName\": \"medical-bill.pdf\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/liens/selling/liens/{{sellerLienId}}/documents",
            "description": "PUT /api/liens/selling/liens/{lienId}/documents. Attach existing document ids from the document service."
          }
        },
        {
          "name": "Submit Lien Intake",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"targetSellerStatus\": \"Pending\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/liens/selling/liens/{{sellerLienId}}/submit",
            "description": "POST /api/liens/selling/liens/{lienId}/submit. Finalizes intake from Draft to Pending or Internal."
          }
        },
        {
          "name": "Get Lien Detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/liens/selling/liens/{{sellerLienId}}",
            "description": "GET /api/liens/selling/liens/{lienId}. Aggregates lien, case, pricing, documents, sale readiness, offers, activity, and actions."
          }
        },
        {
          "name": "Get Lien Activity",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/liens/selling/liens/{{sellerLienId}}/activity",
            "description": "GET /api/liens/selling/liens/{lienId}/activity."
          }
        }
      ]
    },
    {
      "name": "03 - Sale Flow",
      "item": [
        {
          "name": "Prepare Sale",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"buyerFundingCompanyId\": \"{{buyerFundingCompanyId}}\",\n  \"buyerContactId\": \"{{buyerContactId}}\",\n  \"askAmount\": 12500,\n  \"listingVisibility\": \"Private\",\n  \"messageToBuyer\": \"Please review this lien for purchase consideration.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/liens/selling/liens/{{sellerLienId}}/prepare-sale",
            "description": "POST /api/liens/selling/liens/{lienId}/prepare-sale. Moves SellerStatus to PreparedForSale while core Lien.Status remains Draft."
          }
        },
        {
          "name": "Confirm Sale",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"confirmationAccepted\": true,\n  \"sendBuyerNotification\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/liens/selling/liens/{{sellerLienId}}/confirm-sale",
            "description": "POST /api/liens/selling/liens/{lienId}/confirm-sale. Sets SellerStatus=SubmittedForSale, core Lien.Status=Offered, copies AskAmount to Lien.OfferPrice, and keeps SoldAtUtc null. When sendBuyerNotification=true, the API validates persisted buyer/seller/lien/case data, creates a 30-day buyer access link from Liens:Selling:BuyerPortalBaseUrl, and submits the New Lien Offer email idempotently; callers do not provide email placeholder data or a CTA URL."
          }
        },
        {
          "name": "Withdraw Sale",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Seller withdrew sale from Postman collection\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/liens/selling/liens/{{sellerLienId}}/withdraw-sale",
            "description": "POST /api/liens/selling/liens/{lienId}/withdraw-sale."
          }
        },
        {
          "name": "Archive Lien",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Archived from Postman collection\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/liens/selling/liens/{{sellerLienId}}/archive",
            "description": "POST /api/liens/selling/liens/{lienId}/archive. Soft-hides the lien from the selling workflow."
          }
        },
        {
          "name": "Generate Buyer Access Link",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const body = pm.response.json();",
                  "  const token = body.token || body.publicToken || body.accessToken || body.buyerAccessToken;",
                  "  if (token) pm.collectionVariables.set('buyerAccessToken', token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"buyerFundingCompanyId\": \"{{buyerFundingCompanyId}}\",\n  \"buyerContactId\": \"{{buyerContactId}}\",\n  \"expiresInHours\": 168\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/liens/selling/liens/{{sellerLienId}}/buyer-access-links",
            "description": "POST /api/liens/selling/liens/{lienId}/buyer-access-links. Captures public token into {{buyerAccessToken}} if returned."
          }
        }
      ]
    },
    {
      "name": "04 - Bulk Import",
      "item": [
        {
          "name": "Download Bulk Import Template",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/liens/selling/bulk-import-template",
            "description": "GET /api/liens/selling/bulk-import-template."
          }
        },
        {
          "name": "Create Bulk Import",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const body = pm.response.json();",
                  "  const id = body.importId || body.id;",
                  "  if (id) pm.collectionVariables.set('bulkImportId', id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": ""
                },
                {
                  "key": "templateType",
                  "value": "SellingLienImport",
                  "type": "text"
                },
                {
                  "key": "defaultListingVisibility",
                  "value": "Private",
                  "type": "text"
                },
                {
                  "key": "defaultSellerStatus",
                  "value": "Pending",
                  "type": "text"
                }
              ]
            },
            "url": "{{baseUrl}}/api/liens/selling/bulk-imports",
            "description": "POST /api/liens/selling/bulk-imports multipart/form-data. Select a CSV/XLSX file before sending. Captures {{bulkImportId}}."
          }
        },
        {
          "name": "Get Bulk Import",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/liens/selling/bulk-imports/{{bulkImportId}}",
            "description": "GET /api/liens/selling/bulk-imports/{importId}."
          }
        },
        {
          "name": "Get Bulk Import Rows",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/liens/selling/bulk-imports/{{bulkImportId}}/rows?status=all&page=1&pageSize=100",
            "description": "GET /api/liens/selling/bulk-imports/{importId}/rows."
          }
        },
        {
          "name": "Validate Bulk Import",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/liens/selling/bulk-imports/{{bulkImportId}}/validate",
            "description": "POST /api/liens/selling/bulk-imports/{importId}/validate."
          }
        },
        {
          "name": "Confirm Bulk Import",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "url": "{{baseUrl}}/api/liens/selling/bulk-imports/{{bulkImportId}}/confirm",
            "description": "POST /api/liens/selling/bulk-imports/{importId}/confirm."
          }
        },
        {
          "name": "Cancel Bulk Import",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/liens/selling/bulk-imports/{{bulkImportId}}",
            "description": "DELETE /api/liens/selling/bulk-imports/{importId}. Cancels an unconfirmed import."
          }
        }
      ]
    },
    {
      "name": "05 - Authenticated Buyer",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{buyerToken}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Buyer View Lien",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/liens/selling/buyer/liens/{{sellerLienId}}",
            "description": "GET /api/liens/selling/buyer/liens/{lienId}. Requires buyer JWT and LienBrowse permission."
          }
        },
        {
          "name": "Buyer Submit Offer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"offerAmount\": 10000,\n  \"message\": \"Offer submitted from authenticated buyer Postman flow\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/liens/selling/buyer/liens/{{sellerLienId}}/offers",
            "description": "POST /api/liens/selling/buyer/liens/{lienId}/offers. Requires buyer JWT and LienOffer permission."
          }
        },
        {
          "name": "Buyer Decline",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Declined from authenticated buyer Postman flow\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/liens/selling/buyer/liens/{{sellerLienId}}/decline",
            "description": "POST /api/liens/selling/buyer/liens/{lienId}/decline."
          }
        }
      ]
    },
    {
      "name": "06 - Public Token Buyer",
      "auth": {
        "type": "noauth"
      },
      "item": [
        {
          "name": "Public View Lien",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/liens/selling/public/{{buyerAccessToken}}",
            "description": "GET /api/liens/selling/public/{token}. No JWT; token controls tenant, lien, buyer, expiry, and visibility."
          }
        },
        {
          "name": "Public Submit Offer",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"offerAmount\": 10000,\n  \"message\": \"Offer submitted from public token Postman flow\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/liens/selling/public/{{buyerAccessToken}}/offers",
            "description": "POST /api/liens/selling/public/{token}/offers. No JWT."
          }
        },
        {
          "name": "Public Decline",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Declined from public token Postman flow\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/liens/selling/public/{{buyerAccessToken}}/decline",
            "description": "POST /api/liens/selling/public/{token}/decline. No JWT."
          }
        }
      ]
    },
    {
      "name": "07 - Selling Lookups",
      "item": [
        {
          "name": "Funding Companies",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/liens/selling/lookups/funding-companies",
            "description": "GET /api/liens/selling/lookups/funding-companies."
          }
        },
        {
          "name": "Funding Company Contacts",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/liens/selling/lookups/funding-company-contacts?fundingCompanyId={{fundingCompanyId}}",
            "description": "GET /api/liens/selling/lookups/funding-company-contacts."
          }
        },
        {
          "name": "Law Firms",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/liens/selling/lookups/law-firms",
            "description": "GET /api/liens/selling/lookups/law-firms."
          }
        },
        {
          "name": "Case Managers",
          "request": {
