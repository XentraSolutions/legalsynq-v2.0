{
  "info": {
    "_postman_id": "c8c0b109-4b1b-4d51-8d7f-9d83ec06c3bf",
    "name": "LegalSynq Selling V2 API",
    "description": "SynqLien Selling V2 contract. Seller case-draft creation defaults to PreDemand and does not require an idempotency key. Other state-changing requests use a new idempotencyKey for each distinct mutation and reuse it only when retrying that same request.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5009" },
    { "key": "sellerToken", "value": "" },
    { "key": "buyerToken", "value": "" },
    { "key": "idempotencyKey", "value": "selling-v2-postman-001" },
    { "key": "sellerLienId", "value": "00000000-0000-0000-0000-000000000000" },
    { "key": "bulkImportId", "value": "00000000-0000-0000-0000-000000000000" },
    { "key": "buyerAccessToken", "value": "" },
    { "key": "fundingCompanyId", "value": "00000000-0000-0000-0000-000000000000" },
    { "key": "fundingCompanyContactId", "value": "00000000-0000-0000-0000-000000000000" },
    { "key": "medicalProviderId", "value": "00000000-0000-0000-0000-000000000000" },
    { "key": "buyerFundingCompanyId", "value": "00000000-0000-0000-0000-000000000000" },
    { "key": "buyerContactId", "value": "00000000-0000-0000-0000-000000000000" },
    { "key": "handlingLawFirmId", "value": "00000000-0000-0000-0000-000000000000" },
    { "key": "caseManagerId", "value": "00000000-0000-0000-0000-000000000000" },
    { "key": "caseId", "value": "00000000-0000-0000-0000-000000000000" },
    { "key": "facilityId", "value": "00000000-0000-0000-0000-000000000000" },
    { "key": "documentId", "value": "00000000-0000-0000-0000-000000000000" },
    { "key": "contactId", "value": "00000000-0000-0000-0000-000000000000" },
    { "key": "targetContactId", "value": "00000000-0000-0000-0000-000000000000" },
    { "key": "companyTypeId", "value": "10000000-0000-0000-0000-000000000001" },
    { "key": "contactPersonTypeId", "value": "20000000-0000-0000-0000-000000000001" },
    { "key": "companyId", "value": "00000000-0000-0000-0000-000000000000" },
    { "key": "companyContactId", "value": "00000000-0000-0000-0000-000000000000" }
  ],
  "item": [
    {
      "name": "01 - Seller Portfolio",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{sellerToken}}", "type": "string" }] },
      "item": [
        {
          "name": "Get Dashboard",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/liens/selling/dashboard?tab=pending&search=&sortBy=initialServiceDate&sortDirection=desc&page=1&pageSize=25" }
        },
        {
          "name": "List Seller Liens",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/liens/selling/liens?tab=pending&search=&sortBy=initialServiceDate&sortDirection=desc&page=1&pageSize=25" }
        }
      ]
    },
    {
      "name": "02 - Seller Lien Intake and Sale",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{sellerToken}}", "type": "string" }] },
      "item": [
        {
          "name": "Create Selling Case Draft",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const body = pm.response.json();", "if (body.draftId) pm.collectionVariables.set('sellingCaseDraftId', body.draftId);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"accidentTypeId\": \"MVA\",\n  \"accidentState\": \"CA\",\n  \"dateOfLoss\": \"2026-07-30\",\n  \"caseTrackingNotes\": \"Initial Selling intake\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/liens/selling/case-drafts"
          }
        },
        {
          "name": "Update Selling Case Draft",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"accidentTypeId\": \"MVA\",\n  \"accidentState\": \"CA\",\n  \"dateOfLoss\": \"2026-07-30\",\n  \"handlingLawFirmId\": \"{{handlingLawFirmId}}\",\n  \"caseManagerId\": \"{{caseManagerId}}\",\n  \"caseTrackingNotes\": \"Updated Selling draft intake\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/liens/selling/case-drafts/{{sellingCaseDraftId}}"
          }
        },
        {
          "name": "Finalize Selling Case Draft Plaintiff",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const body = pm.response.json();", "if (body.caseId) pm.collectionVariables.set('caseId', body.caseId);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Doe\",\n  \"birthdate\": \"1990-01-01\",\n  \"email\": \"jane@example.test\",\n  \"phone\": \"555-0100\",\n  \"gender\": \"Female\",\n  \"address\": \"100 Main Street\",\n  \"city\": \"Los Angeles\",\n  \"state\": \"CA\",\n  \"zipcode\": \"90001\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/liens/selling/case-drafts/{{sellingCaseDraftId}}/plaintiff"
          }
        },
        {
          "name": "Get Selling Case Information",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/liens/selling/cases/{{caseId}}"
          }
        },
        {
          "name": "Update Selling Case Information",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"accidentTypeId\": \"MVA\",\n  \"accidentState\": \"CA\",\n  \"dateOfLoss\": \"2026-07-30\",\n  \"handlingLawFirmId\": \"{{handlingLawFirmId}}\",\n  \"caseManagerId\": \"{{caseManagerId}}\",\n  \"caseTrackingNotes\": \"Updated Selling case intake\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/liens/selling/cases/{{caseId}}"
          }
        },
        {
          "name": "Update Selling Case Plaintiff",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Doe\",\n  \"birthdate\": \"1990-01-01\",\n  \"email\": \"jane@example.test\",\n  \"phone\": \"555-0100\",\n  \"gender\": \"Female\",\n  \"address\": \"100 Main Street\",\n  \"city\": \"Los Angeles\",\n  \"state\": \"CA\",\n  \"zipcode\": \"90001\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/liens/selling/cases/{{caseId}}/plaintiff"
          }
        },
        {
          "name": "Create Seller Lien (Pending or Internal)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const body = pm.response.json();", "if (body.lienId) pm.collectionVariables.set('sellerLienId', body.lienId);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"caseId\": \"{{caseId}}\",\n  \"sellerStatus\": \"Pending\",\n  \"source\": \"Postman\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/liens/selling/liens"
          }
        },
        {
          "name": "Get Seller Lien Detail",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/liens/selling/liens/{{sellerLienId}}" }
        },
        {
          "name": "Get Seller Lien Activity",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/liens/selling/liens/{{sellerLienId}}/activity" }
        },
        {
          "name": "Save Lien Information",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"sellerStatus\": \"Pending\",\n  \"initialServiceDate\": \"2026-07-30\",\n  \"endServiceDate\": null,\n  \"listingVisibility\": \"Private\",\n  \"notes\": \"Selling V2 intake created from Postman\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/liens/selling/liens/{{sellerLienId}}/lien-information"
          }
        },
        {
          "name": "Save Case Information",
          "request": {
            "description": "Saves lien-owned funding company/contact, facility, and medical provider references. It does not create or update a case, law firm, or case manager.",
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"fundingCompanyId\": \"{{fundingCompanyId}}\",\n  \"fundingCompanyContactId\": \"{{fundingCompanyContactId}}\",\n  \"facilityId\": \"{{facilityId}}\",\n  \"medicalProviderId\": \"{{medicalProviderId}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/liens/selling/liens/{{sellerLienId}}/case-information"
          }
        },
        {
          "name": "Save Medical Pricing",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"askAmount\": 12500,\n  \"billingAmount\": 18000,\n  \"rows\": [{\n    \"medicalCode\": \"99213\",\n    \"description\": \"Office visit\",\n    \"serviceDate\": \"2026-07-30\",\n    \"billingAmount\": 600,\n    \"medicareCost\": 180,\n    \"targetSaleAmount\": 350\n  }]\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/liens/selling/liens/{{sellerLienId}}/medical-pricing"
          }
        },
        {
          "name": "Save Existing Documents",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"documents\": [{\n    \"documentId\": \"{{documentId}}\",\n    \"documentType\": \"MedicalBill\",\n    \"displayName\": \"medical-bill.pdf\"\n  }]\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/liens/selling/liens/{{sellerLienId}}/documents"
          }
        },
        {
          "name": "Prepare Sale",
          "request": {
            "description": "buyerFundingCompanyId and buyerContactId may identify either a legacy funding-company/contact pair or an active Company Directory Funding Company/contact-person pair owned by the authenticated seller organization.",
            "method": "POST",
            "header": [{ "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"buyerFundingCompanyId\": \"{{buyerFundingCompanyId}}\",\n  \"buyerContactId\": \"{{buyerContactId}}\",\n  \"askAmount\": 12500,\n  \"listingVisibility\": \"Private\",\n  \"messageToBuyer\": \"Please review this lien for purchase consideration.\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/liens/selling/liens/{{sellerLienId}}/prepare-sale"
          }
        },
        {
          "name": "Confirm Sale",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"confirmationAccepted\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/liens/selling/liens/{{sellerLienId}}/confirm-sale",
            "description": "POST /api/liens/selling/liens/{lienId}/confirm-sale. Sets SellerStatus=SubmittedForSale, core Lien.Status=Offered, copies AskAmount to Lien.OfferPrice, and keeps SoldAtUtc null. The API always validates persisted buyer/seller/lien/case data, creates 30-day buyer and seller access links from an absolute Liens:Selling:BuyerPortalBaseUrl, or derives it from SYNQLIEN_COMMON_PORTAL_HOSTNAME when the explicit base URL is absent. The API rejects literal localhost/127.0.0.1 CTA links, allows named .localhost aliases such as synqlien-demo.localhost for local demo runs, and submits the buyer and seller New Lien Offer emails idempotently with SendGrid click tracking disabled for the CTA; callers do not provide email placeholder data or a CTA URL and cannot opt out of notifications. For local tenant-portal emails configure Liens__Selling__BuyerPortalBaseUrl to the active web origin, such as http://synqlien-demo.localhost:5000/selling/public for scripts/run-dev.sh or http://synqlien-demo.localhost:3000/selling/public when only apps/web dev is running."
          }
        },
        {
          "name": "Withdraw Sale",
          "request": {
            "method": "POST",
            "header": [{ "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"reason\": \"Seller withdrew the listing.\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/liens/selling/liens/{{sellerLienId}}/withdraw-sale"
          }
        },
        {
          "name": "Archive Unsold Lien",
          "request": {
            "method": "POST",
            "header": [{ "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"reason\": \"No longer needed.\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/liens/selling/liens/{{sellerLienId}}/archive"
          }
        },
        {
          "name": "Create Buyer Access Link",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const body = pm.response.json();", "if (body.token) pm.collectionVariables.set('buyerAccessToken', body.token);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"buyerFundingCompanyId\": \"{{buyerFundingCompanyId}}\",\n  \"buyerContactId\": \"{{buyerContactId}}\",\n  \"expiresInHours\": 168\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/liens/selling/liens/{{sellerLienId}}/buyer-access-links"
          }
        }
      ]
    },
    {
      "name": "03 - Bulk Import",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{sellerToken}}", "type": "string" }] },
      "item": [
        { "name": "Download Template", "request": { "method": "GET", "url": "{{baseUrl}}/api/liens/selling/bulk-import-template" } },
        {
          "name": "Upload Import",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const body = pm.response.json();", "if (body.importId) pm.collectionVariables.set('bulkImportId', body.importId);"] } }],
          "request": {
            "method": "POST",
            "body": { "mode": "formdata", "formdata": [{ "key": "file", "type": "file", "src": "" }, { "key": "templateType", "value": "SellingLienImport", "type": "text" }, { "key": "defaultListingVisibility", "value": "Private", "type": "text" }, { "key": "defaultSellerStatus", "value": "Pending", "type": "text" }] },
            "url": "{{baseUrl}}/api/liens/selling/bulk-imports"
          }
        },
        { "name": "Get Import", "request": { "method": "GET", "url": "{{baseUrl}}/api/liens/selling/bulk-imports/{{bulkImportId}}" } },
        { "name": "Get Import Rows", "request": { "method": "GET", "url": "{{baseUrl}}/api/liens/selling/bulk-imports/{{bulkImportId}}/rows?status=all&page=1&pageSize=100" } },
        { "name": "Validate Import", "request": { "method": "POST", "url": "{{baseUrl}}/api/liens/selling/bulk-imports/{{bulkImportId}}/validate" } },
        { "name": "Confirm Import", "request": { "method": "POST", "header": [{ "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }], "url": "{{baseUrl}}/api/liens/selling/bulk-imports/{{bulkImportId}}/confirm" } },
        { "name": "Cancel Import", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/liens/selling/bulk-imports/{{bulkImportId}}" } }
      ]
    },
    {
      "name": "04 - Selling Lookups",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{sellerToken}}", "type": "string" }] },
      "item": [
        { "name": "Funding Companies", "request": { "method": "GET", "url": "{{baseUrl}}/api/liens/selling/lookups/funding-companies" } },
        { "name": "Funding Company Contacts", "request": { "method": "GET", "url": "{{baseUrl}}/api/liens/selling/lookups/funding-company-contacts?fundingCompanyId={{fundingCompanyId}}" } },
        { "name": "Law Firms", "request": { "method": "GET", "url": "{{baseUrl}}/api/liens/selling/lookups/law-firms" } },
        { "name": "Case Managers", "request": { "method": "GET", "url": "{{baseUrl}}/api/liens/selling/lookups/case-managers?lawFirmId={{handlingLawFirmId}}" } },
        { "name": "Facilities", "request": { "method": "GET", "url": "{{baseUrl}}/api/liens/selling/lookups/facilities" } },
        { "name": "Medical Codes", "request": { "method": "GET", "url": "{{baseUrl}}/api/liens/selling/lookups/medical-codes?search=99213" } },
        { "name": "Document Types", "request": { "method": "GET", "url": "{{baseUrl}}/api/liens/selling/lookups/document-types" } }
      ]
    },
    {
      "name": "05 - Company Directory",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{sellerToken}}", "type": "string" }] },
      "item": [
        { "name": "Company Types", "request": { "method": "GET", "url": "{{baseUrl}}/api/liens/selling/lookups/company-types" } },
        { "name": "Contact Person Types", "request": { "method": "GET", "url": "{{baseUrl}}/api/liens/selling/lookups/contact-person-types?companyTypeId={{companyTypeId}}" } },
        { "name": "List Companies", "request": { "method": "GET", "url": "{{baseUrl}}/api/liens/selling/companies?search=&companyTypeId=&isActive=true&page=1&pageSize=20" } },
        {
          "name": "Create Company",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const body = pm.response.json();", "if (body.id) pm.collectionVariables.set('companyId', body.id);"] } }],
          "request": { "method": "POST", "header": [{ "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"companyTypeId\": \"{{companyTypeId}}\",\n  \"name\": \"Postman Company\",\n  \"addressLine1\": \"100 Main Street\",\n  \"city\": \"Los Angeles\",\n  \"state\": \"CA\",\n  \"postalCode\": \"90001\",\n  \"phone\": \"+15555550100\",\n  \"email\": \"company@example.test\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/liens/selling/companies" }
        },
        { "name": "Get Company", "request": { "method": "GET", "url": "{{baseUrl}}/api/liens/selling/companies/{{companyId}}" } },
        {
          "name": "Update Company",
          "request": { "method": "PUT", "header": [{ "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"linkedTenantId\": null,\n  \"name\": \"Postman Company Updated\",\n  \"addressLine1\": \"200 Main Street\",\n  \"city\": \"Los Angeles\",\n  \"state\": \"CA\",\n  \"postalCode\": \"90002\",\n  \"phone\": \"+15555550101\",\n  \"email\": \"company.updated@example.test\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/liens/selling/companies/{{companyId}}" }
        },
        {
          "name": "Create Company Contact",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const body = pm.response.json();", "if (body.id) pm.collectionVariables.set('companyContactId', body.id);"] } }],
          "request": { "method": "POST", "header": [{ "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"contactPersonTypeId\": \"{{contactPersonTypeId}}\",\n  \"firstName\": \"Alex\",\n  \"lastName\": \"Contact\",\n  \"email\": \"alex@example.test\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/liens/selling/companies/{{companyId}}/contacts" }
        },
        { "name": "List Company Contacts", "request": { "method": "GET", "url": "{{baseUrl}}/api/liens/selling/companies/{{companyId}}/contacts?isActive=true" } },
        { "name": "Get Company Contact", "request": { "method": "GET", "url": "{{baseUrl}}/api/liens/selling/companies/{{companyId}}/contacts/{{companyContactId}}" } },
        {
          "name": "Update Company Contact",
          "request": { "method": "PUT", "header": [{ "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"contactPersonTypeId\": \"{{contactPersonTypeId}}\",\n  \"firstName\": \"Alex\",\n  \"lastName\": \"Contact Updated\",\n  \"addressLine1\": \"200 Main Street\",\n  \"city\": \"Los Angeles\",\n  \"state\": \"CA\",\n  \"postalCode\": \"90002\",\n  \"phone\": \"+15555550102\",\n  \"email\": \"alex.updated@example.test\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/liens/selling/companies/{{companyId}}/contacts/{{companyContactId}}" }
        },
        { "name": "Deactivate Company Contact", "request": { "method": "DELETE", "header": [{ "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }], "url": "{{baseUrl}}/api/liens/selling/companies/{{companyId}}/contacts/{{companyContactId}}" } },
        { "name": "Reactivate Company Contact", "request": { "method": "PUT", "header": [{ "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }], "url": "{{baseUrl}}/api/liens/selling/companies/{{companyId}}/contacts/{{companyContactId}}/reactivate" } },
        { "name": "Deactivate Company", "request": { "method": "DELETE", "header": [{ "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }], "url": "{{baseUrl}}/api/liens/selling/companies/{{companyId}}" } },
        { "name": "Reactivate Company", "request": { "method": "PUT", "header": [{ "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }], "url": "{{baseUrl}}/api/liens/selling/companies/{{companyId}}/reactivate" } }
      ]
    },
    {
      "name": "06 - Authenticated Buyer",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{buyerToken}}", "type": "string" }] },
      "item": [
        { "name": "View Submitted Lien", "request": { "method": "GET", "url": "{{baseUrl}}/api/liens/selling/buyer/liens/by-lien/{{sellerLienId}}" } },
        {
          "name": "Submit Offer",
          "request": { "method": "POST", "header": [{ "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"offerAmount\": 10000,\n  \"message\": \"Offer submitted from Postman.\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/liens/selling/buyer/liens/by-lien/{{sellerLienId}}/offers" }
        },
        {
          "name": "Decline Lien",
          "request": { "method": "POST", "header": [{ "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"reason\": \"Not a fit.\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/liens/selling/buyer/liens/by-lien/{{sellerLienId}}/decline" }
        }
      ]
    },
    {
      "name": "07 - Public Buyer Token",
      "item": [
        { "name": "View Public Lien", "request": { "method": "GET", "url": "{{baseUrl}}/api/liens/selling/public/{{buyerAccessToken}}" } },
        {
          "name": "Accept Public Lien",
          "request": { "method": "POST", "header": [{ "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"notes\": \"Accepted from Postman.\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/liens/selling/public/{{buyerAccessToken}}/accept" }
        },
        {
          "name": "Submit Public Offer",
          "request": { "method": "POST", "header": [{ "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"offerAmount\": 10000,\n  \"message\": \"Public buyer offer.\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/liens/selling/public/{{buyerAccessToken}}/offers" }
        },
        {
          "name": "Decline Public Lien",
          "request": { "method": "POST", "header": [{ "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"reason\": \"Not a fit.\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/liens/selling/public/{{buyerAccessToken}}/decline" }
        },
        {
          "name": "Activate Buyer Account",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"companyName\": \"Buyer Company\",\n  \"email\": \"buyer@example.test\",\n  \"password\": \"Replace-With-A-Strong-Password\",\n  \"firstName\": \"Buyer\",\n  \"lastName\": \"User\",\n  \"phone\": \"+15555550100\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/liens/selling/public/{{buyerAccessToken}}/activate-account" }
        }
      ]
    },
    {
      "name": "08 - Contacts",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{sellerToken}}", "type": "string" }] },
      "item": [
        { "name": "List Contacts", "request": { "method": "GET", "url": "{{baseUrl}}/api/liens/contacts?search=&contactType=&isActive=true&page=1&pageSize=25" } },
        { "name": "Get Contact Detail", "request": { "method": "GET", "url": "{{baseUrl}}/api/liens/contacts/{{contactId}}/detail" } },
        {
          "name": "Reassign Contact Cases",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"targetContactId\": \"{{targetContactId}}\",\n  \"relationshipType\": \"CaseManager\",\n  \"scope\": \"Selected\",\n  \"caseIds\": [\"{{caseId}}\"]\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/liens/contacts/{{contactId}}/reassign-cases" }
        },
        {
          "name": "Export Contacts CSV",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"search\": \"\",\n  \"contactType\": \"FundingCompany\",\n  \"isActive\": true,\n  \"selectedIds\": []\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/liens/contacts/export-csv" }
        }
      ]
    }
  ]
}
