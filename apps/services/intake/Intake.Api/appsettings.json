{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5013"
      }
    }
  },
  "ConnectionStrings": {
    "IntakeDatabase": ""
  },
  "Jwt": {
    "SigningKey": "REPLACE_VIA_SECRET_minimum_32_characters_long",
    "Issuer": "legalsynq-identity",
    "Audience": "legalsynq-platform"
  },
  "ServiceTokens": {
    "Issuer": "legalsynq-service-tokens",
    "Audience": "intake-service"
  },
  "AuditClient": {
    "BaseUrl": "http://localhost:5007",
    "ServiceToken": "",
    "SourceSystem": "legalsynq-platform",
    "SourceService": "intake-service",
    "TimeoutSeconds": 5
  },
  "AllowedHosts": "*"
}