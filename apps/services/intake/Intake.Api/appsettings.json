{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5013"
      }
    }
  },
  "ConnectionStrings": {
    "IntakeDatabase": ""
  },
  "Jwt": {
    "SigningKey": "REPLACE_VIA_SECRET_minimum_32_characters_long",
    "Issuer": "legalsynq-identity",
    "Audience": "legalsynq-platform"
  },
  "ServiceTokens": {
    "Issuer": "legalsynq-service-tokens",
    "Audience": "intake-service"
  },
  "AuditClient": {
    "BaseUrl": "http://localhost:5007",
    "ServiceToken": "",
    "SourceSystem": "legalsynq-platform",
    "SourceService": "intake-service",
    "TimeoutSeconds": 5
  },
  "DocumentsService": {
    "BaseUrl": "http://localhost:5006",
    "DocumentTypeId": ""
  },
  "Intake": {
    "SynqLien": {
      "Enabled": false,
      "BaseUrl": "",
      "TimeoutSeconds": 20,
      "ServiceTokenAudience": "liens-service",
      "OrganizationId": ""
    },
    "EmailArtifacts": {
      "MaxMimeInputBytes": 16777216,
      "MaxArtifactBytes": 26214400,
      "MaxArtifactsPerEmail": 100,
      "MaxTotalArtifactBytesPerEmail": 104857600,
      "MaxMimeDepth": 20,
      "MaxFileNameLength": 240,
      "DocumentsServiceTimeoutSeconds": 60,
      "DocumentsServiceProductId": "SYNQ_INTAKE"
    },
    "Recovery": {
      "Enabled": true,
      "ScanIntervalSeconds": 30,
      "ProcessingStaleAfterMinutes": 10,
      "MaxItemsPerScan": 100,
      "MaxRecoveryAttempts": 5,
      "MaxConcurrentRecoveries": 4,
      "RetryBackoffBaseSeconds": 30,
      "RetryBackoffMaxSeconds": 1800
    }
  },
  "AllowedHosts": "*"
}