<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>Commerce.Api</RootNamespace>
    <AssemblyName>Commerce.Api</AssemblyName>
    <UserSecretsId>commerce-api-7c2a1b9d</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
