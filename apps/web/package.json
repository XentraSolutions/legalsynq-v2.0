{
  "name": "legalsynq-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "NODE_OPTIONS=--max-old-space-size=4096 next build --webpack",
    "start": "next start -p 3000",
    "type-check": "tsc --noEmit",
    "test": "tsx --test src/lib/__tests__/*.test.ts && vitest run",
    "test:e2e": "playwright test",
    "test:e2e:update-snapshots": "playwright test --update-snapshots",
    "playwright:install": "playwright install chromium --with-deps",
    "playwright:install:custom-path": "PLAYWRIGHT_BROWSERS_PATH=$PLAYWRIGHT_BROWSERS_PATH playwright install chromium --with-deps"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/google.maps": "^3.64.0"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.5",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-popover": "^1.1.17",
    "@radix-ui/react-select": "^2.3.1",
    "@tanstack/react-query": "^5.101.1",
    "@types/leaflet": "^1.9.21",
    "class-variance-authority": "^0.7.1",
    "framer-motion": "^12.40.0",
    "leaflet": "^1.9.4",
    "next": "16.2.6",
    "react": "^18.3.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^15.0.0",
    "react-leaflet": "^4.2.1",
    "remixicon": "^4.9.1",
    "sharp": "^0.35.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "overrides": {
    "brace-expansion": "^5.0.6",
    "file-type": "^22.0.1",
    "fast-xml-parser": "^5.7.1",
    "postcss": "^8.5.10",
    "uuid": "^11.1.1"
  },
  "pnpm": {
    "overrides": {
      "next": "^16.2.6",
      "postcss": "^8.5.10",
      "brace-expansion": "^5.0.6",
      "file-type": "^22.0.1",
      "fast-xml-parser": "^5.7.1",
      "uuid": "^11.1.1"
    }
  }
}
