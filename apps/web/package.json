{
  "name": "legalsynq-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "NODE_OPTIONS=--max-old-space-size=4096 next build --webpack",
    "start": "next start -p 3000",
    "type-check": "tsc --noEmit",
    "test": "tsx --test src/lib/__tests__/*.test.ts && vitest run",
    "test:e2e": "playwright test",
    "test:e2e:qa": "E2E_ENV=qa playwright test",
    "test:e2e:prod": "E2E_ENV=production playwright test",
    "test:e2e:mocked": "playwright test --config=playwright.mocked.config.ts",
    "test:e2e:mocked:update-snapshots": "playwright test --config=playwright.mocked.config.ts --update-snapshots",
    "playwright:install": "playwright install chromium --with-deps",
    "playwright:install:custom-path": "PLAYWRIGHT_BROWSERS_PATH=$PLAYWRIGHT_BROWSERS_PATH playwright install chromium --with-deps"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/google.maps": "^3.64.0",
    "msw": "^2.15.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-checkbox": "^1.3.5",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-popover": "^1.1.17",
    "@radix-ui/react-select": "^2.3.1",
    "@react-input/mask": "^2.0.4",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-table": "^8.21.3",
    "@types/leaflet": "^1.9.21",
    "class-variance-authority": "^0.7.1",
    "framer-motion": "^12.40.0",
    "leaflet": "^1.9.4",
    "next": "16.2.6",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^15.0.0",
    "react-leaflet": "^4.2.1",
    "recharts": "^3.9.2",
    "remixicon": "^4.9.1",
    "sharp": "^0.35.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "overrides": {
    "brace-expansion": "^5.0.6",
    "file-type": "^22.0.1",
    "fast-xml-parser": "^5.7.1",
    "postcss": "^8.5.10",
    "uuid": "^11.1.1"
  }
}
